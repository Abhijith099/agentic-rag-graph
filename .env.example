# ==========================================
# 1. Database Configuration (PostgreSQL + pgvector)
# ==========================================
DATABASE_URL=postgresql://user:password@ep-host.region.aws.neon.tech/neondb?sslmode=require

# ==========================================
# 2. Knowledge Graph (Neo4j Aura)
# ==========================================
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USER=your_neo4j_username
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=your_neo4j_database_id

# ==========================================
# 3. LLM Configuration (Agent Reasoning)
# ==========================================
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_groq_api_key_here
LLM_CHOICE=llama-3.3-70b-versatile

# ==========================================
# 4. Embedding Configuration (Local or Remote)
# ==========================================
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text
VECTOR_DIMENSION=1536

# ==========================================
# 5. Server Configuration
# ==========================================
APP_HOST=0.0.0.0
APP_PORT=8058
